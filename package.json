{
  "name": "listeningspaces.net",
  "version": "1.0.0",
  "private": true,
  "description": "a directory of hi-fi listening spaces",
  "license": "MIT",
  "author": "James Vaughan <james@jamesbvaughan.com>",
  "repository": "https://github.com/jamesbvaughan/listeningspaces.net",
  "scripts": {
    "dev": "hugo server --printPathWarnings",
    "build": "hugo --minify --printPathWarnings",
    "format": "oxfmt . && gotmplfmt -w layouts content",
    "check-format": "oxfmt --check .",
    "check-templates": "gotmplfmt -l layouts content | (! grep .)",
    "lint-data": "ajv -s data/spaces.schema.json -d data/spaces.yaml -c ajv-formats"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "ajv-cli": "^5.0.0",
    "ajv-formats": "^3.0.1",
    "oxfmt": "^0.60.0",
    "tailwindcss": "^4.3.3"
  }
}
